# === AZURE OPENAI ===
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT_NAME=text-embedding-3-small

# === AZURE BLOB STORAGE ===
# Get from Azure Portal > Storage Accounts > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=finance-ai-data

# === DATABASE ===
# For local development (SQLite):
DATABASE_URL=sqlite:///finance_ai.db
# For production (PostgreSQL on Render):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# === SMTP GMAIL CONFIGURATION ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# === CORS / FRONTEND URL ===
FRONTEND_URL=http://localhost:5173
# For production:
# FRONTEND_URL=https://your-app.vercel.app
